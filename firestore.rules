rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só lê e escreve o próprio progresso.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
